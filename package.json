{
  "name": "low-code-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Low-code platform monorepo",
  "scripts": {
    "dev:frontend": "pnpm --filter @lowcode/frontend dev",
    "dev:backend": "pnpm --filter @lowcode/backend start:dev",
    "dev:renderer": "pnpm --filter @lowcode/renderer start:dev",
    "build:common": "pnpm --filter @lowcode/common build",
    "build:frontend": "pnpm --filter @lowcode/frontend build",
    "build:backend": "pnpm --filter @lowcode/backend build",
    "build:renderer": "pnpm --filter @lowcode/renderer build",
    "build": "pnpm build:common && pnpm build:frontend && pnpm build:backend && pnpm build:renderer",
    "lint": "eslint packages/*/src --ext .ts,.tsx,.vue",
    "format": "prettier --write 'packages/*/src/**/*.{ts,tsx,vue}'"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.20.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
