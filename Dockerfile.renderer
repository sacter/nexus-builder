FROM node:20-alpine AS builder

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app
COPY pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages/common/package.json packages/common/tsconfig.json packages/common/
COPY packages/renderer/package.json packages/renderer/tsconfig.json packages/renderer/nest-cli.json packages/renderer/

RUN pnpm install --frozen-lockfile || pnpm install

COPY packages/common/src packages/common/src/
COPY packages/renderer/src packages/renderer/src/

RUN pnpm build:common
RUN pnpm --filter @lowcode/renderer build

FROM node:20-alpine

WORKDIR /app
COPY --from=builder /app/packages/renderer/dist ./dist
COPY --from=builder /app/packages/renderer/node_modules ./node_modules
COPY --from=builder /app/packages/common/dist ./packages/common/dist

EXPOSE 3001
CMD ["node", "dist/main.js"]
